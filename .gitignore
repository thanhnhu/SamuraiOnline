# ---------------------------------------------------------------------------
# A trailing slash alone is not anchored: "Game/" would also match the Photon
# demo's Scripts/Game/ folder, so these are rooted with a leading slash.
/Game/
/Decompiled code/
*.SPR
*.BGR
*.PRG
*.FIX
*.GID
SAMURAI2.EXE
KILLSAM.EXE

# Assets extracted by SamuraiTools/sprtool
/SamuraiAssets/
SamuraiTools/sprtool/out/
**/extracted/

# The Unity attempt imported the same game data. Its own tutorial audio in
# Assets/Audio/ is unrelated and stays.
unity-prototype/Assets/_Project/Resources/
unity-prototype/Assets/_Project/Audio/

# Characters generated by SamuraiTools/chargen: derived from game art, and
# regenerable from source, so there is no reason to commit them.
Ikemen-GO/chars/jubei/
Ikemen-GO/chars/jubei2/

# Build outputs
Ikemen_GO_Linux
Ikemen_GO*.exe
# Anchored, or the pattern would also swallow the cmd/netcheck source directory.
/Ikemen-GO/netcheck
/Ikemen-GO/netcheck.exe
*.test
*.out

# `go build ./...` drops a binary named after the module next to its source.
/SamuraiLobby/SamuraiLobby
/SamuraiLobby/lobby
/SamuraiTools/sprtool/sprtool
/SamuraiTools/chargen/chargen

# Third-party MUGEN screenpack, unmodified and separately licensed.
# Clone it yourself: https://github.com/ikemen-engine/Ikemen-GO-Screenpack
/Screenpack/

# Community gamepad database, fetched by setup.sh. Not ours to redistribute.
Ikemen-GO/external/gamecontrollerdb.txt

# Local runtime state
Ikemen-GO/save/
Ikemen-GO/debug/

